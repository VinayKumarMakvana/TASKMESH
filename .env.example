# TaskMesh Production Environment Configuration Template
# Copy this file to .env and adjust values before launching

# Network Configuration
TASKMESH_HOST=0.0.0.0
TASKMESH_PORT=8080

# Concurrency
TASKMESH_WORKERS=4

# Persistent Storage (SQLite WAL)
TASKMESH_DB_PATH=/data/taskmesh.db

# Authentication Secret (Change this to a strong, high-entropy secret before public deployment)
TASKMESH_API_KEY=tm_live_secret_key_replace_in_production
